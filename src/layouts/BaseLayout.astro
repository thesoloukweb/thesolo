---
import '@/styles/globals.css';
import GoogleAnalytics from '@/components/GoogleAnalytics.astro';
import NotificationSystem from '@/components/NotificationSystem.astro';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: URL | string;
}

const {
  title = 'TheSolo Kitchen & Bar - Mediterranean Restaurant in London',
  description = 'Experience vibrant Mediterranean flavors at TheSolo Kitchen & Bar. Authentic dishes, elegant surroundings, and exceptional service in the heart of London.',
  image = '/images/restaurant-1.jpg',
  canonicalURL = new URL(Astro.url.pathname, Astro.site)
} = Astro.props;

const siteTitle = 'TheSolo Kitchen & Bar';
const fullTitle = title === siteTitle ? title : `${title} | ${siteTitle}`;
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#001223" />
    
    <title>{fullTitle}</title>
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:site_name" content="TheSolo Kitchen & Bar" />
    <meta property="og:locale" content="en_GB" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.url)} />
    <meta name="twitter:site" content="@thesolo_london" />
    
    <!-- Additional SEO -->
    <meta name="author" content="TheSolo Kitchen & Bar" />
    <meta name="keywords" content="Mediterranean restaurant London, East London dining, Bethnal Green restaurant, Mediterranean cuisine, rooftop bar London, private dining London, authentic Mediterranean food" />
    <meta name="geo.region" content="GB-LND" />
    <meta name="geo.placename" content="London" />
    <meta name="geo.position" content="51.5285;-0.0563" />
    <meta name="ICBM" content="51.5285, -0.0563" />
    
    <!-- Google Analytics -->
    <GoogleAnalytics />
    
    <!-- Performance Optimizations -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    
    <!-- Critical CSS for fonts -->
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Crimson+Text:wght@400;600;700&family=Josefin+Sans:wght@300;400;500;600;700&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Crimson+Text:wght@400;600;700&family=Josefin+Sans:wght@300;400;500;600;700&display=swap" />
    </noscript>
    
    <!-- Preload critical above-the-fold images -->
    {Astro.url.pathname === '/' && (
      <>
      <link rel="preload" href="/images/hero-left.jpg" as="image" type="image/jpeg" />
        <link rel="preload" href="/images/hero-right.jpg" as="image" type="image/jpeg" />
      </>
    )}
    {Astro.url.pathname === '/menu' && (
      <>
        <link rel="preload" href="/images/menu-breakfast.jpg" as="image" type="image/jpeg" />
        <link rel="preload" href="/images/menu-1.jpg" as="image" type="image/jpeg" />
      <link rel="preload" href="/images/menu-3.jpg" as="image" type="image/jpeg" />
      </>
    )}
    {Astro.url.pathname === '/gallery' && (
      <link rel="preload" href="/images/restaurant-1.jpg" as="image" type="image/jpeg" />
    )}
    {Astro.url.pathname === '/reservation' && (
      <link rel="preload" href="/images/reservation-hero.jpg" as="image" type="image/jpeg" />
    )}
  </head>
  <body class="h-full font-josefin bg-brand-dark text-white antialiased">
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe src={`https://www.googletagmanager.com/ns.html?id=${import.meta.env.GOOGLE_TAG_MANAGER_ID}`}
              height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>
    
    <!-- Skip to main content for accessibility -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-0 focus:left-0 z-50 btn-primary">
      Skip to main content
    </a>
    
    <div class="min-h-full flex flex-col">
      <slot />
    </div>
    
    <!-- Notification System -->
    <NotificationSystem />
    
    <!-- JSON-LD Schema: Restaurant -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": ["Restaurant", "LocalBusiness", "FoodEstablishment"],
        "@id": "https://thesolo.co.uk/#restaurant",
        "name": "The Solo Kitchen & Bar",
        "alternateName": ["TheSolo Kitchen & Bar", "The Solo Bistro Bar", "Solo Kitchen and Bar London"],
        "description": "The Solo Kitchen & Bar is a premier Mediterranean restaurant in East London, offering authentic Turkish, Greek and Italian cuisine, rooftop dining, signature cocktails, live Sunday Jazz Sessions, and private event spaces. Family-friendly atmosphere with vibrant flavours from across the Mediterranean.",
        "slogan": "Mediterranean flavours in the heart of East London",
        "url": "https://thesolo.co.uk",
        "telephone": "+442080142656",
        "email": "info@thesolo.co.uk",
        "logo": {
          "@type": "ImageObject",
          "url": "https://thesolo.co.uk/images/logo.png",
          "width": 187,
          "height": 182
        },
        "image": [
          "https://thesolo.co.uk/images/restaurant-1.jpg",
          "https://thesolo.co.uk/images/restaurant-3.jpg",
          "https://thesolo.co.uk/images/restaurant-5.jpg",
          "https://thesolo.co.uk/images/hero-left.jpg",
          "https://thesolo.co.uk/images/hero-right.jpg"
        ],
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Museum Gardens",
          "addressLocality": "London",
          "addressRegion": "Greater London",
          "addressCountry": "GB",
          "postalCode": "E2 9PA"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": "51.5285",
          "longitude": "-0.0563"
        },
        "areaServed": [
          {
            "@type": "City",
            "name": "London"
          },
          {
            "@type": "Place",
            "name": "East London"
          },
          {
            "@type": "Place",
            "name": "Bethnal Green"
          },
          {
            "@type": "Place",
            "name": "Hackney"
          },
          {
            "@type": "Place",
            "name": "Shoreditch"
          }
        ],
        "servesCuisine": ["Mediterranean", "Turkish", "Greek", "Italian", "Middle Eastern"],
        "priceRange": "££",
        "paymentAccepted": ["Cash", "Credit Card", "Debit Card", "Contactless"],
        "currenciesAccepted": "GBP",
        "keywords": "mediterranean restaurant london, turkish restaurant east london, rooftop dining london, cocktail bar bethnal green, private dining london, jazz brunch london, halal mediterranean, family restaurant east london, best mediterranean food london, breakfast brunch east london",
        "openingHoursSpecification": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday"],
            "opens": "08:30",
            "closes": "23:30"
          },
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Friday", "Saturday"],
            "opens": "08:30",
            "closes": "00:30"
          },
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": "Sunday",
            "opens": "08:30",
            "closes": "23:30"
          }
        ],
        "acceptsReservations": "True",
        "hasMenu": [
          {
            "@type": "Menu",
            "name": "Breakfast & Brunch Menu",
            "url": "https://thesolo.co.uk/pdfs/breakfast-and-brunch.pdf",
            "inLanguage": "en-GB"
          },
          {
            "@type": "Menu",
            "name": "À La Carte Menu",
            "url": "https://thesolo.co.uk/pdfs/a-la-carte.pdf",
            "inLanguage": "en-GB"
          },
          {
            "@type": "Menu",
            "name": "Drinks Menu",
            "url": "https://thesolo.co.uk/pdfs/drinks.pdf",
            "inLanguage": "en-GB"
          },
          {
            "@type": "Menu",
            "name": "Party Sharing Platter",
            "url": "https://thesolo.co.uk/menu",
            "inLanguage": "en-GB"
          }
        ],
        "menu": "https://thesolo.co.uk/menu",
        "makesOffer": [
          {
            "@type": "Offer",
            "name": "Blue Light Card Discount",
            "description": "20% discount for Blue Light Card holders (NHS, emergency services, armed forces, teachers and social care workers)",
            "eligibleCustomerType": "Blue Light Card Holders"
          },
          {
            "@type": "Offer",
            "name": "Sunday Jazz Sessions",
            "description": "Live jazz on the rooftop every Sunday from 12 PM to 3 PM, featuring Mediterranean cuisine and panoramic views"
          }
        ],
        "amenityFeature": [
          { "@type": "LocationFeatureSpecification", "name": "Rooftop Terrace", "value": true },
          { "@type": "LocationFeatureSpecification", "name": "Private Dining", "value": true },
          { "@type": "LocationFeatureSpecification", "name": "Cocktail Bar", "value": true },
          { "@type": "LocationFeatureSpecification", "name": "Outdoor Seating", "value": true },
          { "@type": "LocationFeatureSpecification", "name": "Live Music", "value": true },
          { "@type": "LocationFeatureSpecification", "name": "Family Friendly", "value": true },
          { "@type": "LocationFeatureSpecification", "name": "Wheelchair Accessible", "value": true },
          { "@type": "LocationFeatureSpecification", "name": "Free WiFi", "value": true },
          { "@type": "LocationFeatureSpecification", "name": "Vegetarian Options", "value": true },
          { "@type": "LocationFeatureSpecification", "name": "Vegan Options", "value": true }
        ],
        "knowsAbout": [
          "Mediterranean cuisine",
          "Turkish cuisine",
          "Greek cuisine",
          "Italian cuisine",
          "Cocktails and mixology",
          "Wine pairing",
          "Private events",
          "Corporate dining",
          "Birthday celebrations",
          "Sunday brunch",
          "Live jazz performances"
        ],
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "4.8",
          "reviewCount": "127",
          "bestRating": "5",
          "worstRating": "1"
        },
        "sameAs": [
          "https://www.instagram.com/thesolokitchenandbar/",
          "https://www.facebook.com/people/The-Solo-Bistro-Bar/61556764776020/",
          "https://www.tiktok.com/@thesolobistrobar",
          "https://web.dojo.app/create_booking/vendor/rhkYepQTtlYY4_Zb8eocC3p7GrYTT9KN2K1P6Tdx4cA_restaurant"
        ]
      }
    </script>

    <!-- JSON-LD Schema: WebSite (for sitelinks search box) -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "@id": "https://thesolo.co.uk/#website",
        "url": "https://thesolo.co.uk",
        "name": "The Solo Kitchen & Bar",
        "description": "Mediterranean restaurant in East London - Turkish, Greek, Italian cuisine with rooftop dining",
        "publisher": { "@id": "https://thesolo.co.uk/#restaurant" },
        "inLanguage": "en-GB"
      }
    </script>

    <!-- JSON-LD Schema: FAQ Page (helps AI engines answer common questions) -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Where is The Solo Kitchen & Bar located?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "The Solo Kitchen & Bar is located at Museum Gardens, London E2 9PA, in the heart of East London, near Bethnal Green."
            }
          },
          {
            "@type": "Question",
            "name": "What type of cuisine does The Solo Kitchen & Bar serve?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "We serve authentic Mediterranean cuisine with Turkish, Greek, Italian and Middle Eastern influences. Our menu features fresh ingredients, breakfast and brunch options, à la carte dining, sharing platters, signature cocktails and an extensive drinks list."
            }
          },
          {
            "@type": "Question",
            "name": "What are the opening hours of The Solo Kitchen & Bar?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "We are open Monday to Thursday 8:30am to 11:30pm, Friday and Saturday 8:30am to 12:30am, and Sunday 8:30am to 11:30pm."
            }
          },
          {
            "@type": "Question",
            "name": "Does The Solo Kitchen & Bar offer a Blue Light Card discount?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes, we offer a 20% discount for Blue Light Card holders, including NHS staff, emergency services, armed forces, teachers and social care workers."
            }
          },
          {
            "@type": "Question",
            "name": "Can I book a table at The Solo Kitchen & Bar?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes, you can book a table directly through our website at thesolo.co.uk/reservation or via Dojo at https://web.dojo.app/create_booking/vendor/rhkYepQTtlYY4_Zb8eocC3p7GrYTT9KN2K1P6Tdx4cA_restaurant. We accept reservations for both regular dining and private events."
            }
          },
          {
            "@type": "Question",
            "name": "Does The Solo Kitchen & Bar have a rooftop?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes, we have a beautiful rooftop terrace with panoramic views of London. Every Sunday from 12pm to 3pm, we host live Sunday Jazz Sessions on the rooftop."
            }
          },
          {
            "@type": "Question",
            "name": "Does The Solo Kitchen & Bar host private events?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes, we offer private dining and event spaces accommodating groups from 6 to 200+ guests. We host birthdays, corporate events, weddings and special celebrations. Contact us via 020 8014 2656 or info@thesolo.co.uk for bookings."
            }
          },
          {
            "@type": "Question",
            "name": "Is The Solo Kitchen & Bar family-friendly?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes, we are family-friendly with a relaxed casual smart dress code. We welcome guests of all ages and offer a variety of menu options for everyone."
            }
          },
          {
            "@type": "Question",
            "name": "What is the dress code at The Solo Kitchen & Bar?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Casual smart dress code is appreciated at The Solo Kitchen & Bar."
            }
          },
          {
            "@type": "Question",
            "name": "Does The Solo Kitchen & Bar serve breakfast?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes, we serve our Breakfast & Brunch menu daily from 8:30am until 3:00pm, featuring Mediterranean-inspired dishes with fresh ingredients and traditional flavours."
            }
          }
        ]
      }
    </script>
  </body>
</html>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  
  .focus\\:not-sr-only:focus {
    position: static;
    width: auto;
    height: auto;
    padding: inherit;
    margin: inherit;
    overflow: visible;
    clip: auto;
    white-space: normal;
  }
</style>