---
import '@/styles/globals.css';
import GoogleAnalytics from '@/components/GoogleAnalytics.astro';
import NotificationSystem from '@/components/NotificationSystem.astro';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: URL | string;
  /**
   * Page-specific JSON-LD (FAQPage, BlogPosting, BreadcrumbList …). Rendered after
   * the site-wide Restaurant and WebSite blocks. Site-wide markup must never claim
   * something that is only true for one page, so page-level types live here.
   */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = 'TheSolo Kitchen & Bar - Mediterranean Restaurant in London',
  description = 'Experience vibrant Mediterranean flavors at TheSolo Kitchen & Bar. Authentic dishes, elegant surroundings, and exceptional service in the heart of London.',
  image = '/images/restaurant-1.jpg',
  canonicalURL = new URL(Astro.url.pathname, Astro.site),
  jsonLd
} = Astro.props;

/**
 * BreadcrumbList, derived from the URL so every page declares where it sits
 * without each page repeating itself. The home page is skipped: a breadcrumb
 * trail with a single item carries no information.
 */
const SEGMENT_LABELS: Record<string, string> = {
  about: 'About Us',
  menu: 'Menu',
  gallery: 'Gallery',
  contact: 'Contact',
  reservation: 'Reservation',
  faq: 'FAQ',
  blog: 'Blog',
};

const segments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumb = segments.length === 0 ? null : {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: new URL('/', Astro.site).toString(),
    },
    ...segments.map((segment, i) => ({
      '@type': 'ListItem',
      position: i + 2,
      // Known routes get a clean label; anything else (a blog slug) uses the
      // page's own title, minus the brand suffix.
      name: SEGMENT_LABELS[segment] ?? title.split('|')[0].trim(),
      item: new URL(segments.slice(0, i + 1).join('/') + '/', Astro.site).toString(),
    })),
  ],
};

const provided = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const pageSchemas = [breadcrumb, ...provided].filter(Boolean) as Record<string, unknown>[];

// A "<" inside the JSON (e.g. "</script>" in an answer) would terminate the
// script element early; escaping it keeps the JSON valid and the HTML intact.
const serialiseSchema = (schema: Record<string, unknown>) =>
  JSON.stringify(schema).replace(/</g, '\\u003c');

const siteTitle = 'TheSolo Kitchen & Bar';

// Only append the brand when the title does not already carry it. Pages set their
// own titles and most of them already name the restaurant, which previously
// produced "... | TheSolo Kitchen & Bar | TheSolo Kitchen & Bar".
const brandPattern = /the\s*solo\s+kitchen\s*(&|and)\s*bar/i;
const fullTitle = brandPattern.test(title) ? title : `${title} | ${siteTitle}`;

// One absolute origin for every URL this page declares about itself. Astro.url
// is the URL being built and carries whatever host the build ran under, so the
// canonical, Open Graph and Twitter tags are all derived from Astro.site instead.
const pageURL = canonicalURL.toString();
const imageURL = new URL(image, Astro.site).toString();

/**
 * Only the production build invites indexing.
 *
 * Vercel gives every preview deployment its own *.vercel.app address, and that is
 * precisely how a staging copy of this site ended up publicly crawlable and
 * competing with the live domain. VERCEL_ENV is 'production', 'preview' or
 * 'development'; anything that is not production asks robots to stay away.
 * A local build sets nothing, so it behaves like production.
 */
const vercelEnv = process.env.VERCEL_ENV;
const indexable = !vercelEnv || vercelEnv === 'production';
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={indexable ? 'index, follow' : 'noindex, nofollow'} />
    <meta name="theme-color" content="#001223" />
    
    <title>{fullTitle}</title>
    <link rel="canonical" href={pageURL} />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:url" content={pageURL} />
    <meta property="og:site_name" content="TheSolo Kitchen & Bar" />
    <meta property="og:locale" content="en_GB" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:site" content="@thesolo_london" />
    
    <!-- Additional SEO -->
    <meta name="author" content="TheSolo Kitchen & Bar" />
    <meta name="geo.region" content="GB-LND" />
    <meta name="geo.placename" content="London" />
    <meta name="geo.position" content="51.5285;-0.0563" />
    <meta name="ICBM" content="51.5285, -0.0563" />
    
    <!-- Google Analytics -->
    <GoogleAnalytics />
    
    <!--
      Fonts are served from this domain (see src/styles/fonts.css), so the
      fonts.googleapis.com → fonts.gstatic.com chain and its preconnect hints
      are gone. Only the two faces that draw above-the-fold text are preloaded;
      the rest arrive with the stylesheet.
    -->
    <link rel="preload" href="/fonts/crimson-text-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/josefin-sans-400-latin.woff2" as="font" type="font/woff2" crossorigin />

    <!--
      There were per-page image preloads here for /menu, /gallery and /reservation.
      They never fired: the conditions compared Astro.url.pathname against '/menu'
      while the directory build makes it '/menu/', so the tags were dead on the live
      site too. Rather than repair them, they are gone — every image they pointed at
      is now either processed by astro:assets under a content-hashed name this layout
      cannot know, or replaced entirely. The elements themselves carry loading and
      fetchpriority, which is the better signal.
    -->
  </head>
  <body class="h-full font-josefin bg-brand-dark text-white antialiased">
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe src={`https://www.googletagmanager.com/ns.html?id=${import.meta.env.GOOGLE_TAG_MANAGER_ID}`}
              height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>
    
    <!-- Skip to main content for accessibility -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-0 focus:left-0 z-50 btn-primary">
      Skip to main content
    </a>
    
    <div class="min-h-full flex flex-col">
      <slot />
    </div>
    
    <!-- Notification System -->
    <NotificationSystem />
    
    <!-- JSON-LD Schema: Restaurant -->
    <script type="application/ld+json" is:inline>
