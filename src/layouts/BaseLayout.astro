    </script>

    <!-- JSON-LD Schema: WebSite (for sitelinks search box) -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "@id": "https://www.thesolo.co.uk/#website",
        "url": "https://www.thesolo.co.uk",
        "name": "The Solo Kitchen & Bar",
        "description": "Mediterranean restaurant in East London - Turkish, Greek, Italian cuisine with rooftop dining",
        "publisher": { "@id": "https://www.thesolo.co.uk/#restaurant" },
        "inLanguage": "en-GB"
      }
    </script>

    <!--
      Page-specific JSON-LD. The FAQPage block that used to live here was emitted on
      every page while the questions were visible on none — markup that does not
      describe the page it sits on. The FAQ page now generates its own block from the
      same array it renders, so the two cannot drift. (Google withdrew the FAQ rich
      result in May 2026; an accurate block still describes the page for other
      consumers, but it earns no search feature.)
    -->
    {pageSchemas.map((schema) => (
      <script type="application/ld+json" is:inline set:html={serialiseSchema(schema)} />
    ))}
  </body>
</html>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  
  .focus\\:not-sr-only:focus {
    position: static;
    width: auto;
    height: auto;
    padding: inherit;
    margin: inherit;
    overflow: visible;
    clip: auto;
    white-space: normal;
  }
</style>