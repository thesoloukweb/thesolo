---
/**
 * Hero: the client's film, whole and uncropped.
 *
 * Third iteration, to the client's explicit brief (September 2026): do it like
 * pink-cafe.co.uk. A solid header, and under it the film edge to edge at its
 * own 16:9 aspect ratio, so nothing is ever cut off the sides, and at its full
 * 33-second length, so nothing is cut out of the middle either. No overlays on
 * the picture, no frame, no crop. The name and the facts sit in a band below.
 *
 * On a desktop a full-width 16:9 video effectively is a full-height hero
 * (1440px wide makes it 810px tall); on a phone it becomes a letterbox band
 * with the content right under it, which is the honest cost of "never crop".
 *
 * Mechanics that must survive any redesign:
 *   - The poster <img> is the LCP element (astro:assets, eager, high priority).
 *     It is frame 0 of the film, the Bethnal Green Underground sign, so the
 *     crossfade into playback is seamless.
 *   - The <video> has no source in HTML and preload="none". Sources are attached
 *     after window.load, then the film fades in over the poster.
 *   - prefers-reduced-motion, Save-Data and 2G get the poster only.
 *   - Phones get an 854x480 encode (2.2 MB), everything else 1600x900 (6.6 MB).
 *     Full length costs weight; it is deferred, so first paint never pays it.
 *   - A labelled pause control sits in the caption line under the film
 *     (WCAG 2.2.2). It stays hidden until the film is really playing.
 */
import { Image } from 'astro:assets';
import poster from '@/assets/hero-poster.jpg';

// Bump when the encodes change so the immutable cache header cannot serve stale files.
const VIDEO_VERSION = 'v3';
---

<section id="hero" class="hero-cine" data-video-version={VIDEO_VERSION}>
  <!-- The film: full width, its own aspect ratio, nothing cropped. -->
  <div class="hc-media">
    <Image
      src={poster}
      alt=""
      class="hc-poster"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      format="webp"
      quality={72}
      width={1920}
      widths={[640, 1024, 1600, 1920]}
      sizes="100vw"
    />
    <video
      id="hero-video"
      class="hc-video"
      muted
      playsinline
      loop
      preload="none"
      aria-hidden="true"
      tabindex="-1"
      disablepictureinpicture
      disableRemotePlayback
    ></video>
  </div>

  <!-- The name and the facts, on the green below the film. -->
  <div class="hc-band">
    <div class="container-custom hc-band-in">
      <h1 class="hc-title hc-rise hc-d1">
        The Solo <span class="hc-sub">Kitchen &amp; Bar</span>
      </h1>

      <p class="hc-lede hc-rise hc-d2">
        A Mediterranean kitchen and cocktail bar in Museum Gardens, Bethnal Green,
        with a rooftop terrace under a retractable roof, garden tables and bottomless brunch.
      </p>

      <!--
        Reservation CTA, phones only. On a phone the header collapses to a
        burger, so without this nothing near the top leads to a booking. On a
        desktop the header's RESERVATION button is always visible.
      -->
      <div class="hc-cta-row hc-rise hc-d2">
        <a class="hc-cta" href="/reservation/">
          <span class="hc-cta-t">Book a table</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>

      <div class="hc-ledger hc-rise hc-d3">
        <span class="hc-cell hc-hrs"><b>Open daily</b><span>10:00 to 23:30, Fri and Sat to 00:30</span></span>
        <span class="hc-cell hc-addr"><b class="hc-dt">Find us</b><span>Museum Gardens, <span class="hc-dt">Cambridge Heath Road, </span>E2 9PA</span></span>
        <a class="hc-cell" href="tel:+442080142656">020 8014 2656</a>
        <span class="hc-spacer" aria-hidden="true"></span>
        <button class="hc-pause" id="hero-video-toggle" type="button" data-state="playing" aria-label="Pause film" aria-hidden="true">
          <svg class="hc-stop" viewBox="0 0 9 10" aria-hidden="true"><rect x="0" y="0" width="3" height="10"/><rect x="6" y="0" width="3" height="10"/></svg>
          <svg class="hc-play" viewBox="0 0 9 10" aria-hidden="true"><path d="M0 0l9 5-9 5z"/></svg>
          <span class="hc-pause-label"><span class="hc-w">Pause</span><span class="hc-dt"> film</span></span>
        </button>
      </div>
    </div>
  </div>
</section>

<!--
  Global on purpose: the poster is rendered by <Image>, and every selector below
  is namespaced with hc- so nothing leaks.
-->
<style is:global>
  .hero-cine {
    --hdr: 140px;       /* fixed header: banner 33 + nav 107, measured; breakpoints below */
    --green: #102B2A;
    --copper: #C49A85;
    --cream: #F3ECE4;
    --hair: rgba(243, 236, 228, .18);
    --ease: cubic-bezier(.22, 1, .36, 1);
    background: var(--green);
    color: var(--cream);
    font-family: 'Josefin Sans', system-ui, sans-serif;
  }
  /*
    Header height is deterministic, so it is declared rather than measured
    (reading offsetHeight at load forced a full document layout; see the
    performance work of 5 September). Measured per breakpoint, with and without
    the dismissable discount banner.
  */
  @media (max-width: 639px) { .hero-cine { --hdr: 102px; } }
  @media (min-width: 640px) and (max-width: 1023px) { .hero-cine { --hdr: 146px; } }
  html[data-blc="closed"] .hero-cine { --hdr: 107px; }
  @media (max-width: 639px) { html[data-blc="closed"] .hero-cine { --hdr: 73px; } }
  @media (min-width: 640px) and (max-width: 1023px) { html[data-blc="closed"] .hero-cine { --hdr: 113px; } }

  /*
    globals.css has #hero { min-height: 100vh }. This hero's height is whatever
    the uncropped film plus the band add up to; on a desktop that already fills
    the screen, and on a phone stretching it would just pad the band with empty
    green. The ID keeps this rule in charge.
  */
  #hero.hero-cine {
    min-height: auto;
  }

  /*
    The film's box IS the film's shape: aspect-ratio 16/9, never cropped. Its
    width obeys two ceilings at once:

      - the page gutter on both sides, the same --page-gutter every section uses;
      - the first screen: header plus film must not exceed the viewport, so the
        width is also capped at (viewport height - header) x 16/9. On a short
        wide screen the film simply gets narrower and stays centred, instead of
        running past the fold or getting cropped.

    The sources are 16:9, so object-fit: cover scales without cutting anything;
    it only absorbs sub-pixel rounding that contain would render as a hairline.
  */
  .hc-media {
    position: relative;
    width: min(100% - 2 * var(--page-gutter, 16px), calc((100vh - var(--hdr)) * 16 / 9));
    width: min(100% - 2 * var(--page-gutter, 16px), calc((100svh - var(--hdr)) * 16 / 9));
    aspect-ratio: 16 / 9;
    margin: var(--hdr) auto 0;   /* under the fixed header, centred when height-capped */
    background: #0D1B1E;
    overflow: hidden;
  }
  .hc-poster,
  .hc-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .hc-video { opacity: 0; transition: opacity 1.2s var(--ease); }
  .hc-video.is-on { opacity: 1; }

  /* The band under the film. */
  .hc-band { padding: 40px 0 44px; }
  .hc-band-in { max-width: 1400px; }
  .hc-title {
    margin: 0 0 14px;
    font-family: 'Crimson Text', Georgia, serif;
    font-weight: 400;
    font-size: clamp(34px, 4.6vw, 58px);
    line-height: 1.08;
    color: var(--cream);
  }
  /* One accessible name, two visual weights: "The Solo" leads, the rest in copper. */
  .hc-title .hc-sub { color: var(--copper); }
  .hc-lede {
    margin: 0;
    max-width: 640px;
    font-size: 16px;
    font-weight: 300;
    line-height: 1.6;
    color: rgba(243, 236, 228, .85);
  }

  .hc-cta-row { display: none; }

  /* Caption line: hours, address, phone, and the pause control as its last cell. */
  .hc-ledger {
    position: relative;
    margin-top: 26px;
    padding: 16px 0 0;
    display: flex; align-items: center; flex-wrap: wrap; row-gap: 14px;
    font-size: 13px; font-weight: 400; letter-spacing: .02em; line-height: 1;
    color: rgba(243, 236, 228, .78); white-space: nowrap;
  }
  .hc-ledger::before { content: ""; position: absolute; left: 0; right: 0; top: 0; height: 1px; background: var(--hair); }
  .hc-cell { padding: 0 22px; border-left: 1px solid var(--hair); display: inline-flex; align-items: baseline; gap: 10px; }
  .hc-cell:first-child { padding-left: 0; border-left: 0; }
  .hc-cell b { font-weight: 500; font-size: 10.5px; letter-spacing: .2em; text-transform: uppercase; color: var(--copper); }
  a.hc-cell { color: var(--cream); transition: color .4s var(--ease); }
  a.hc-cell:hover { color: var(--copper); }
  .hc-spacer { flex: 1; }
  .hc-pause {
    padding: 8px 0 8px 22px; min-height: 44px; margin: -8px 0; border-left: 1px solid var(--hair);
    display: inline-flex; align-items: center; gap: 10px;
    background: none; border-top: 0; border-right: 0; border-bottom: 0; cursor: pointer;
    font: inherit; font-weight: 500; font-size: 11px; letter-spacing: .18em; text-transform: uppercase; color: var(--cream);
    visibility: hidden; opacity: 0; transition: opacity .6s var(--ease), color .4s var(--ease);
  }
  .hc-pause.is-on { visibility: visible; opacity: 1; }
  .hc-pause:hover { color: var(--copper); }
  .hc-pause:focus-visible { outline: 2px solid var(--copper); outline-offset: 3px; }
  .hc-pause svg { width: 9px; height: 10px; fill: currentColor; flex: none; }
  .hc-pause .hc-play { display: none; }
  .hc-pause[data-state="paused"] .hc-play { display: block; }
  .hc-pause[data-state="paused"] .hc-stop { display: none; }
  .hc-pause-label { padding-top: 2px; }

  /* Entrance: the band only. The poster is the LCP element and never animates. */
  .hc-rise { opacity: 0; transform: translateY(16px); animation: hc-rise .8s var(--ease) forwards; }
  .hc-d1 { animation-delay: .1s; }
  .hc-d2 { animation-delay: .22s; }
  .hc-d3 { animation-delay: .34s; }
  @keyframes hc-rise { to { opacity: 1; transform: none; } }

  @media (prefers-reduced-motion: reduce) {
    .hc-rise { animation: none; opacity: 1; transform: none; }
    .hc-video, .hc-pause { display: none; }
  }

  /* Below xl the caption drops its long form so the row never wraps. */
  @media (max-width: 1279px) {
    .hc-ledger .hc-dt { display: none; }
  }

  @media (max-width: 767px) {
    .hc-band { padding: 26px 0 30px; }
    .hc-title { font-size: clamp(30px, 8.4vw, 36px); margin-bottom: 10px; }
    .hc-lede { font-size: 15px; line-height: 1.55; }
    .hc-cta-row { display: flex; margin-top: 18px; }
    .hc-cta {
      display: inline-flex; align-items: center; justify-content: space-between; gap: 16px;
      flex: 1; height: 54px; padding: 0 22px 0 24px; border-radius: 2px;
      background: var(--copper); color: var(--green);
      font-family: 'Crimson Text', Georgia, serif; font-weight: 600; font-size: 18px; letter-spacing: .01em; line-height: 1;
      transition: transform .45s var(--ease), background-color .3s var(--ease);
    }
    .hc-cta svg { width: 20px; height: 20px; flex: none; }
    .hc-cta:active { transform: translateY(1px); }
    .hc-cta:focus-visible { outline: 2px solid var(--cream); outline-offset: 3px; }
    .hc-cta-t { padding-top: 3px; }
    .hc-ledger { margin-top: 22px; font-size: 12.5px; }
    .hc-cell { padding: 0 12px; }
    .hc-cell.hc-hrs { flex-basis: 100%; padding-left: 0; border-left: 0; }
    .hc-cell.hc-addr { padding-left: 0; border-left: 0; }
    .hc-spacer { display: none; }
    .hc-pause { padding-left: 12px; font-size: 10.5px; margin-left: auto; }
  }
</style>

<script>
  const video = document.getElementById('hero-video') as HTMLVideoElement | null;
  const toggle = document.getElementById('hero-video-toggle') as HTMLButtonElement | null;
  const section = document.getElementById('hero');

  if (video && toggle && section) {
    const version = section.dataset.videoVersion || 'v3';
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const conn = (navigator as any).connection;
    const slow = !!conn && (conn.saveData || /(^|-)2g$/.test(conn.effectiveType || ''));

    // The film is a decoration. Anyone who asked for less motion, or is paying
    // per megabyte, gets the poster and nothing else.
    if (!reduced && !slow) {
      let userPaused = false;
      const word = toggle.querySelector('.hc-w');

      const setState = (playing: boolean) => {
        toggle.dataset.state = playing ? 'playing' : 'paused';
        toggle.setAttribute('aria-label', playing ? 'Pause film' : 'Play film');
        if (word) word.textContent = playing ? 'Pause' : 'Play';
      };

      const attach = () => {
        const small = window.matchMedia('(max-width: 767px)').matches;
        const base = `/video/hero-${version}-${small ? '720' : '1080'}`;
        // AV1 first for browsers that decode it; the codecs string lets Safari
        // skip straight to the MP4 instead of downloading a file it cannot play.
        for (const [type, ext] of [
          ['video/webm; codecs="av01.0.05M.08"', 'webm'],
          ['video/mp4', 'mp4'],
        ]) {
          const source = document.createElement('source');
          source.src = `${base}.${ext}`;
          source.type = type;
          video.appendChild(source);
        }
        video.load();
        video.addEventListener('canplay', () => {
          video.play().then(() => {
            video.classList.add('is-on');
            toggle.classList.add('is-on');
            toggle.removeAttribute('aria-hidden');
            setState(true);
          }).catch(() => { /* autoplay refused: the poster stays, no control */ });
        }, { once: true });
      };

      // Nothing about the film starts until the page has finished loading.
      const DELAY = 300;
      if (document.readyState === 'complete') {
        setTimeout(attach, DELAY);
      } else {
        window.addEventListener('load', () => setTimeout(attach, DELAY), { once: true });
      }

      toggle.addEventListener('click', () => {
        if (video.paused) {
          userPaused = false;
          video.play().then(() => setState(true)).catch(() => {});
        } else {
          userPaused = true;
          video.pause();
          setState(false);
        }
      });

      // Do not burn CPU and battery on a film nobody can see.
      const visible = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (!video.querySelector('source')) return;
          if (e.isIntersecting && !userPaused && document.visibilityState === 'visible') {
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        }
      }, { threshold: 0.15 });
      visible.observe(section);

      document.addEventListener('visibilitychange', () => {
        if (!video.querySelector('source')) return;
        if (document.visibilityState === 'hidden') video.pause();
        else if (!userPaused) video.play().catch(() => {});
      });
    }
  }
</script>
