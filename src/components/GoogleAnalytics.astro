---
// Google Analytics bileşeni
const GOOGLE_ANALYTICS_ID = import.meta.env.GOOGLE_ANALYTICS_ID;
const GOOGLE_TAG_MANAGER_ID = import.meta.env.GOOGLE_TAG_MANAGER_ID;
---

{GOOGLE_ANALYTICS_ID && (
  <>
    {/*
      The gtag.js loader used to sit here. It is gone because the Google Tag
      container below already loads the same runtime AND already fires this exact
      measurement ID — the container source contains G-6G14ZQHWSZ — so the page
      was downloading roughly 500 KB of identical tag runtime twice.

      What stays is the dataLayer shim and the config call: gtag() only pushes
      onto window.dataLayer, which the container reads, and this is the only place
      the privacy options (IP anonymisation, no ad personalisation) are set.
    */}
    <script is:inline define:vars={{ GOOGLE_ANALYTICS_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', GOOGLE_ANALYTICS_ID, {
        page_title: document.title,
        page_location: window.location.href,
        anonymize_ip: true,
        allow_google_signals: false,
        allow_ad_personalization_signals: false
      });
    </script>
  </>
)}

{GOOGLE_TAG_MANAGER_ID && (
  <>
    <!-- Google Tag Manager -->
    <!--
      The container is 168 KB of JavaScript and, measured on the deployed site,
      it was spending about 250 ms of the page's 336 ms of blocking time while
      the hero was still painting. Nothing in it needs to run that early.

      It now loads at the first idle moment, at the latest after three seconds,
      and immediately if the visitor interacts before then. The gtm.start
      timestamp is still stamped at page load, so the container reports the real
      page load time rather than the moment it was injected, and pageviews are
      not lost: dataLayer collects everything pushed before the container arrives.
    -->
    <script is:inline define:vars={{ GOOGLE_TAG_MANAGER_ID }}>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var loaded = false;
        function load() {
          if (loaded) return;
          loaded = true;
          var f = d.getElementsByTagName(s)[0];
          var j = d.createElement(s);
          var dl = l != 'dataLayer' ? '&l=' + l : '';
          j.async = true;
          j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
          f.parentNode.insertBefore(j, f);
        }
        ['pointerdown', 'keydown', 'touchstart', 'scroll'].forEach(function (e) {
          w.addEventListener(e, load, { once: true, passive: true });
        });
        if ('requestIdleCallback' in w) w.requestIdleCallback(load, { timeout: 3000 });
        else w.setTimeout(load, 3000);
      })(window, document, 'script', 'dataLayer', GOOGLE_TAG_MANAGER_ID);
    </script>
  </>
)}
