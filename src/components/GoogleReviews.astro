---
/**
 * Real Google reviews, pulled into src/data/reviews.json by scripts/fetch-reviews.mjs.
 *
 * Nothing here is invented. If the file holds no reviews the section renders as a
 * heading plus a link to the Google listing — never placeholder cards.
 *
 * Deliberately NO Review / aggregateRating JSON-LD: Google rules a business
 * ineligible for review stars when it publishes reviews about itself, so the markup
 * would earn nothing while re-creating the structured-data policy breach this
 * component was rebuilt to remove.
 */
import rawData from '@/data/reviews.json';

interface Review {
  id: string;
  name: string;
  stars: number;
  text: string;
  publishedAt: string | null;
  url: string | null;
  photo: string | null;
  localGuide: boolean;
  reviewCount: number | null;
  ownerReply: string | null;
}

interface ReviewData {
  fetchedAt: string | null;
  source: string;
  placeId: string;
  placeUrl: string;
  reviewUrl?: string;
  totalReviewCount: number | null;
  rating: number | null;
  scraped: number;
  reviews: Review[];
}

// The committed file starts empty, so TypeScript would otherwise infer never[].
const data = rawData as ReviewData;

const reviews = data.reviews ?? [];
const hasReviews = reviews.length > 0;
const placeUrl = data.placeUrl;
const reviewUrl = data.reviewUrl;
const total = data.totalReviewCount;
const rating = data.rating;

const monthYear = (iso: string | null) =>
  iso ? new Intl.DateTimeFormat('en-GB', { month: 'short', year: 'numeric' }).format(new Date(iso)) : '';

const initial = (name: string) => (name.trim()[0] || '?').toUpperCase();

// The marquee scrolls one full copy of the track, so the list is rendered twice.
// The second copy is hidden from assistive technology to avoid reading duplicates.
const track = [...reviews, ...reviews];

// Longer lists need proportionally longer durations or the cards fly past.
const duration = Math.max(40, reviews.length * 7);
---

<section id="google-reviews" class="py-10 sm:py-14 bg-brand-dark overflow-hidden">
  <div class="container-custom px-4 sm:px-6 lg:px-0">
    <div class="text-center mb-8">
      <h2 class="font-crimson text-3xl sm:text-4xl text-brand-gold mb-3">Customer Reviews</h2>
      {total ? (
        <p class="font-josefin text-sm sm:text-base text-white/70">
          {rating ? (
            <>
              Rated <span class="text-brand-gold font-semibold">{rating}</span> out of 5 from{' '}
            </>
          ) : null}
          <span class="text-brand-gold font-semibold">{total.toLocaleString('en-GB')}</span> Google reviews
        </p>
      ) : (
        <p class="font-josefin text-sm sm:text-base text-white/70">Read what our guests say on Google</p>
      )}
    </div>
  </div>

  {hasReviews && (
    <div class="reviews-marquee relative" role="region" aria-label="Recent guest reviews from Google">
      <div class="reviews-track flex gap-4 sm:gap-5 w-max" style={`--marquee-duration:${duration}s`}>
        {track.map((review, i) => (
          <article
            class="review-card w-[300px] sm:w-[340px] flex-shrink-0 flex flex-col rounded-2xl border border-brand-gold/15 bg-white/[0.03] p-5 sm:p-6"
            aria-hidden={i >= reviews.length ? 'true' : undefined}
          >
            <header class="flex items-center gap-3 mb-4">
              {/*
                The avatar is hot-linked from Google. If it fails to load the
                lettered fallback underneath is revealed, so a card is never
                left with a broken image.
              */}
              <span
                class="relative flex-shrink-0 w-10 h-10 rounded-full bg-brand-gold/15 border border-brand-gold/30 flex items-center justify-center font-crimson text-lg text-brand-gold overflow-hidden"
                aria-hidden="true"
              >
                {initial(review.name)}
                {review.photo && (
                  <img
                    src={review.photo}
                    alt=""
                    width="40"
                    height="40"
                    loading="lazy"
                    decoding="async"
                    referrerpolicy="no-referrer"
                    class="absolute inset-0 w-full h-full object-cover"
                    onerror="this.remove()"
                  />
                )}
              </span>
              <div class="min-w-0 flex-1">
                <p class="font-josefin text-sm text-white font-medium truncate">
                  {review.name}
                  {review.localGuide && (
                    <span class="ml-1.5 align-middle text-[10px] uppercase tracking-wide text-brand-gold font-normal">Local Guide</span>
                  )}
                </p>
                <p class="flex items-center gap-2 mt-0.5">
                  <span class="flex text-brand-gold" role="img" aria-label={`${review.stars} out of 5 stars`}>
                    {Array.from({ length: 5 }).map((_, s) => (
                      <svg
                        class={s < review.stars ? 'w-3.5 h-3.5' : 'w-3.5 h-3.5 text-white/20'}
                        fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"
                      ><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                    ))}
                  </span>
                  <span class="font-josefin text-xs text-white/60">{monthYear(review.publishedAt)}</span>
                </p>
              </div>
              <svg class="w-4 h-4 flex-shrink-0 opacity-80 self-start mt-1" viewBox="0 0 24 24" aria-hidden="true">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
              </svg>
            </header>

            <blockquote class="font-josefin text-sm text-white/85 leading-relaxed review-text">
              {review.text}
            </blockquote>
          </article>
        ))}
      </div>
    </div>
  )}

  <div class="container-custom px-4 sm:px-6 lg:px-0">
    <div class="text-center mt-8">
      <a
        href={placeUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center bg-brand-gold border-2 border-brand-gold text-brand-dark px-5 py-2.5 rounded-lg hover:bg-transparent hover:text-brand-gold transition-all duration-300 font-semibold text-sm"
      >
        <svg class="w-4 h-4 mr-2" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
        </svg>
        {total ? `Read all ${total.toLocaleString('en-GB')} reviews on Google` : 'Read our reviews on Google'}
      </a>
      {reviewUrl && (
        <a
          href={reviewUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center ml-0 sm:ml-3 mt-3 sm:mt-0 border-2 border-brand-gold/40 text-brand-gold px-5 py-2.5 rounded-lg hover:border-brand-gold hover:bg-brand-gold/10 transition-all duration-300 font-semibold text-sm"
        >
          Leave a review
        </a>
      )}
      <p class="font-josefin text-xs text-white/65 mt-3">Reviews from Google, shown newest first</p>
    </div>
  </div>
</section>

<style>
  /* Fade the cards out at both edges so the loop has no visible seam. */
  .reviews-marquee {
    -webkit-mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
  }

  .reviews-track {
    animation: reviews-scroll var(--marquee-duration, 60s) linear infinite;
    will-change: transform;
  }

  /* Half of the track is a duplicate, so one full cycle lands seamlessly. */
  @keyframes reviews-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  .reviews-marquee:hover .reviews-track,
  .reviews-marquee:focus-within .reviews-track {
    animation-play-state: paused;
  }

  .review-card {
    transition: border-color .3s ease, background-color .3s ease;
  }
  .reviews-marquee:hover .review-card { border-color: rgba(196, 154, 133, .1); }
  .review-card:hover { border-color: rgba(196, 154, 133, .45); background-color: rgba(255, 255, 255, .06); }

  /* Every card is the same height whatever the quote length, and a long quote is
     clipped rather than allowed to stretch the row. */
  .review-text {
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: calc(5 * 1.625em);
  }

  /* No motion for anyone who asked not to have it — the row stays swipeable. */
  @media (prefers-reduced-motion: reduce) {
    .reviews-marquee {
      overflow-x: auto;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .reviews-track { animation: none; }
  }
</style>
