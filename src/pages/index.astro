---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
// HeroSlider.astro is kept in the repo untouched for an easy rollback.
import HeroVideo from '@/components/HeroVideo.astro';
// Exceptional Dining & Cocktail Moments is off the home page at the client's
// request (September 2026). The component is untouched, so putting it back
// is this import and the tag below.
// import CategorySection from '@/components/CategorySection.astro';
import ReservationSection from '@/components/ReservationSection.astro';
import MenuGrid from '@/components/MenuGrid.astro';
import EventsSection from '@/components/EventsSection.astro';
import RestaurantGallery from '@/components/RestaurantGallery.astro';
import BlogSection from '@/components/BlogSection.astro';
import GoogleReviews from '@/components/GoogleReviews.astro';
import DiscountPopup from '@/components/DiscountPopup.astro';
import Footer from '@/components/Footer.astro';
---

<BaseLayout
  title="Mediterranean Restaurant East London | TheSolo Kitchen & Bar"
  description="Authentic Mediterranean cuisine in East London. Rooftop dining, craft cocktails and private events, minutes from Bethnal Green station."
  image="/images/restaurant-1.jpg"
>
  <main id="main-content" class="min-h-screen">
    <!-- Header with Navigation -->
    <Header />
    
    <!-- Hero: the client's film, whole and uncropped, under the solid header -->
    <HeroVideo />
    
    <!-- The same menu grid the /menu/ page shows, one component, no drift. -->
    <MenuGrid />
    
    <!-- Category Section (Private Dining & Cocktail Bar) — hidden at the
         client's request; uncomment this and the import to bring it back. -->
    <!-- <CategorySection /> -->
    
    <!-- Events Section -->
    <EventsSection />
    
    <!-- Restaurant Gallery Section -->
    <RestaurantGallery />
    
    <!-- Blog/News Section -->
    <BlogSection />
    
    <!-- Google Reviews Section -->
    <GoogleReviews />
    
    <!-- Reservation Form Section -->
    <ReservationSection />
  </main>
  
  <!-- Footer -->
  <Footer />
  
  <!-- Discount Popup (First-time visitors only) -->
  <DiscountPopup />
</BaseLayout>