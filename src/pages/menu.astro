---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import MenuGrid from '@/components/MenuGrid.astro';
---

<BaseLayout 
  title="Mediterranean Menu | TheSolo Kitchen & Bar - East London" 
  description="Authentic Mediterranean menu featuring breakfast, à la carte dishes, craft cocktails & party packages. Download PDF menus. Bethnal Green, London."
  image="/images/menu-3.jpg"
>
  <Header />
  
  <main>
    <!-- Hero Section -->
    <section class="relative h-96 sm:h-[500px] lg:h-[600px] flex items-center justify-center bg-brand-dark">
      <!-- Hero Background Image -->
      <div class="absolute inset-0 z-0">
        <Image 
          src="/images/menu-3.jpg" 
          alt="TheSolo Kitchen & Bar Menu" 
          class="w-full h-full object-cover"
          loading="eager"
          width={1200}
          height={600}
          format="webp"
          quality={90}
        />
        <div class="absolute inset-0 bg-black/60"></div>
      </div>
      
      <!-- Hero Content -->
      <div class="relative z-10 container-custom text-center py-12 mt-16">
        <!-- Content Background -->
        <div class="bg-brand-dark/80 backdrop-blur-sm rounded-2xl px-8 py-12 max-w-4xl mx-auto border border-brand-gold/20">
          <h1 class="font-crimson text-3xl sm:text-4xl md:text-5xl lg:text-6xl text-white mb-6">
            Our
            <span class="text-brand-gold block">Menu Collection</span>
          </h1>
          <p class="font-josefin text-base sm:text-lg text-white/95 max-w-2xl mx-auto leading-relaxed">
            Discover our authentic Mediterranean flavors through our diverse menu selection. Click any menu to view the full PDF.
          </p>
        </div>
      </div>
    </section>

    <!-- Menu Categories Section -->
    <MenuGrid />

    <!-- Call to Action -->
    <section class="section-padding bg-brand-dark">
      <div class="container-custom text-center">
        <h2 class="font-crimson text-3xl sm:text-4xl md:text-5xl text-brand-gold mb-8">
          Ready to Dine?
        </h2>
        <p class="font-josefin text-lg text-white/90 max-w-2xl mx-auto leading-relaxed mb-12">
          Book your table now and experience the authentic Mediterranean flavors that make TheSolo Kitchen & Bar special.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-6 justify-center">
          <a 
            href="/contact/"
            class="btn-primary text-lg px-8 py-4"
          >
            Make a Reservation
          </a>
          <a 
            href="/gallery/"
            class="btn-secondary text-lg px-8 py-4"
          >
            View Gallery
          </a>
        </div>
      </div>
    </section>
  </main>
  
  <!-- Footer -->
  <Footer />
</BaseLayout>



